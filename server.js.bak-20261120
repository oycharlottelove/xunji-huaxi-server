const http = require('http');
const fs = require('fs');
const path = require('path');

const PORT = process.env.PORT || 3000;
const PUBLIC_DIR = path.join(__dirname, 'public');

// 简易 .env 加载（不依赖 dotenv）
function loadEnv() {
  const envPath = path.join(__dirname, '.env');
  if (!fs.existsSync(envPath)) return;
  const lines = fs.readFileSync(envPath, 'utf-8').split(/\r?\n/);
  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) continue;
    const idx = trimmed.indexOf('=');
    if (idx === -1) continue;
    const key = trimmed.slice(0, idx).trim();
    const val = trimmed.slice(idx + 1).trim().replace(/^["']|["']$/g, '');
    if (!process.env[key]) process.env[key] = val;
  }
}
loadEnv();

const MIME_TYPES = {
  '.html': 'text/html; charset=utf-8',
  '.css': 'text/css; charset=utf-8',
  '.js': 'application/javascript; charset=utf-8',
  '.json': 'application/json; charset=utf-8',
  '.png': 'image/png',
  '.jpg': 'image/jpeg',
  '.jpeg': 'image/jpeg',
  '.svg': 'image/svg+xml'
};

function sendJson(res, statusCode, data) {
  res.writeHead(statusCode, { 'Content-Type': 'application/json; charset=utf-8' });
  res.end(JSON.stringify(data));
}

function readBody(req, maxBytes = 12 * 1024 * 1024) {
  return new Promise((resolve, reject) => {
    let size = 0;
    const chunks = [];
    req.on('data', chunk => {
      size += chunk.length;
      if (size > maxBytes) {
        reject(new Error('请求体过大，请压缩图片后重试（上限 12MB）'));
        req.destroy();
        return;
      }
      chunks.push(chunk);
    });
    req.on('end', () => {
      try {
        const raw = Buffer.concat(chunks).toString('utf-8');
        resolve(raw ? JSON.parse(raw) : {});
      } catch (err) {
        reject(new Error('无效的 JSON 请求体'));
      }
    });
    req.on('error', reject);
  });
}

function extractJsonFromText(text) {
  if (!text) throw new Error('模型返回为空');
  const fenced = text.match(/```(?:json)?\s*([\s\S]*?)```/i);
  const candidate = fenced ? fenced[1].trim() : text.trim();
  const start = candidate.indexOf('{');
  const end = candidate.lastIndexOf('}');
  if (start === -1 || end === -1 || end <= start) {
    throw new Error('未能从模型输出中提取有效 JSON');
  }
  return JSON.parse(candidate.slice(start, end + 1));
}

async function callDeepSeek({ apiKey, model, messages, temperature = 0.3 }) {
  const response = await fetch('https://api.deepseek.com/chat/completions', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${apiKey}`
    },
    body: JSON.stringify({
      model,
      messages,
      temperature
    })
  });

  const data = await response.json().catch(() => ({}));
  if (!response.ok) {
    const msg = data?.error?.message || `DeepSeek API 错误 (${response.status})`;
    throw new Error(msg);
  }
  return data.choices?.[0]?.message?.content || '';
}

function resolveApiKey(req, body) {
  return (body && body.apiKey && body.apiKey.trim()) ||
    req.headers['x-deepseek-key'] ||
    process.env.DEEPSEEK_API_KEY ||
    '';
}

// 1. 题目识图/文本拆解为步进式流程图 JSON
async function handleAnalyze(req, res) {
  try {
    const body = await readBody(req);
    const apiKey = resolveApiKey(req, body);
    if (!apiKey) {
      return sendJson(res, 400, { error: '请先在页面右上角配置 DeepSeek API Key，或在 .env 中设置 DEEPSEEK_API_KEY。' });
    }

    const { mode = 'industrial', questionText = '', imageDataUrl = '' } = body;
    if (!questionText.trim() && !imageDataUrl) {
      return sendJson(res, 400, { error: '请至少输入题目文本或上传一张题目截图。' });
    }

    const modeLabel = mode === 'organic' ? '高中化学有机推断与合成路线' : '高中化学化工工业流程';
    const systemPrompt = `你是一位拥有20年教龄的高中化学特级教师，擅长用“苏格拉底式思维脚手架”引导学生攻克【${modeLabel}】大题。
你的任务是将用户提供的题目拆解为 4~6 个循序渐进的流程节点，帮助学生一步步独立思考，**绝不能一上来就给出最终答案**。

请严格按照以下 JSON 格式输出（不要输出任何多余解释文字）：
{
  "title": "简短的题目名称（如：废旧锂电池回收制备Co3O4工艺流程）",
  "mode": "${mode}",
  "core_goal": "一句话概括本题的原料、目标产物及核心主线",
  "knowledge_tags": ["考点1", "考点2", "考点3"],
  "nodes": [
    {
      "id": 1,
      "step_name": "环节名称（如：酸浸与氧化）",
      "material_change": "物质转化主线（如：LiCoO2 + H2SO4 + H2O2 → Co2+ + Li+）",
      "scaffold_question": "第一层：启发式反问（引导学生自己思考这一步为什么要加该试剂/控制该条件）",
      "hint_level_1": "第二层：方向点拨（只给思考切入点，不直接给方程式或结论）",
      "hint_level_2": "第二层进阶：关键反应原理或试剂作用提示",
      "key_equation": "第三层：规范配平的化学/离子方程式及条件（用常见化学符号如 Fe²⁺、SO₄²⁻、↑、↓、⇌）",
      "trap_alert": "第三层：高考高频易错点/扣分陷阱"
    }
  ]
}

科学性硬性约束：
1. 所有化学式、离子电荷、原子守恒、得失电子守恒必须 100% 准确。
2. scaffold_question 必须具有启发性，不能直接剧透 key_equation 的答案。`;

    const hasImage = Boolean(imageDataUrl && imageDataUrl.startsWith('data:image/'));
    const model = hasImage ? 'deepseek-flash' : 'deepseek-chat';

    const userContent = hasImage
      ? [
          {
            type: 'text',
            text: questionText.trim()
              ? `请识别图片中的化学题目，并结合补充说明进行步进式流程拆解：\n${questionText}`
              : '请识别图片中的化学题目，并将其拆解为步进式思维脚手架 JSON。'
          },
          {
            type: 'image_url',
            image_url: { url: imageDataUrl }
          }
        ]
      : `请将以下化学题目拆解为步进式思维脚手架 JSON：\n\n${questionText}`;

    const rawOutput = await callDeepSeek({
      apiKey,
      model,
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: userContent }
      ],
      temperature: 0.25
    });

    const parsed = extractJsonFromText(rawOutput);
    return sendJson(res, 200, { ok: true, modelUsed: model, data: parsed });
  } catch (err) {
    return sendJson(res, 500, { error: err.message || '题目拆解失败' });
  }
}

// 2. 学生思路点评（苏格拉底式即时反馈）
async function handleEvaluateThought(req, res) {
  try {
    const body = await readBody(req);
    const apiKey = resolveApiKey(req, body);
    if (!apiKey) {
      return sendJson(res, 400, { error: '未配置 DeepSeek API Key，当前仅可使用离线演示模式。' });
    }

    const { node, studentThought } = body;
    if (!node || !studentThought || !studentThought.trim()) {
      return sendJson(res, 400, { error: '请输入你的思考思路后再提交点评。' });
    }

    const systemPrompt = `你是高中化学特级教师，正在辅导学生做流程题的某一个环节。
请根据该环节的真实原理，对学生的想法进行简短、精准、鼓励性的点评（120字以内）：
1. 先肯定学生说对的部分；
2. 如果有遗漏或科学性偏差（如漏了氧化还原、未考虑水解、官能团位置判断有误），用启发式追问点出来；
3. 如果学生已经完全答到核心点，明确表扬并提示他可以点击“解锁标准解析”核对方程式。`;

    const userPrompt = `【当前环节】${node.step_name}（${node.material_change}）
【引导问题】${node.scaffold_question}
【参考核心原理】${node.hint_level_2}；方程式：${node.key_equation}
【学生的回答】${studentThought}`;

    const feedback = await callDeepSeek({
      apiKey,
      model: 'deepseek-chat',
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: userPrompt }
      ],
      temperature: 0.4
    });

    return sendJson(res, 200, { ok: true, feedback: feedback.trim() });
  } catch (err) {
    return sendJson(res, 500, { error: err.message || '思路点评失败' });
  }
}

// 3. 基于薄弱节点生成靶向变式题
async function handleVariant(req, res) {
  try {
    const body = await readBody(req);
    const apiKey = resolveApiKey(req, body);
    if (!apiKey) {
      return sendJson(res, 400, { error: '未配置 DeepSeek API Key。' });
    }

    const { topicTitle, weakNodes = [], mode = 'industrial' } = body;
    const weakDesc = weakNodes.length
      ? weakNodes.map(n => `${n.step_name}（${n.material_change}）`).join('；')
      : '流程综合分析与离子方程式书写';

    const systemPrompt = `你是高中化学命题专家。请针对学生刚才在【${topicTitle}】（${mode === 'organic' ? '有机推断' : '化工流程'}）中卡壳的薄弱环节：${weakDesc}，命制 1 道高质量的单选微变式题。
严格输出以下 JSON 格式：
{
  "question": "题干内容（含具体化学情境）",
  "options": ["A. 选项1", "B. 选项2", "C. 选项3", "D. 选项4"],
  "answer": "B",
  "analysis": "详细解析（说明为什么选该项，以及其他选项的错误原因）",
  "target_skill": "本题巩固的核心考点"
}`;

    const rawOutput = await callDeepSeek({
      apiKey,
      model: 'deepseek-chat',
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: '请生成 1 道靶向变式巩固题。' }
      ],
      temperature: 0.4
    });

    const parsed = extractJsonFromText(rawOutput);
    return sendJson(res, 200, { ok: true, data: parsed });
  } catch (err) {
    return sendJson(res, 500, { error: err.message || '变式题生成失败' });
  }
}

const server = http.createServer(async (req, res) => {
  const urlPath = req.url.split('?')[0];

  if (req.method === 'GET' && urlPath === '/api/health') {
    return sendJson(res, 200, {
      ok: true,
      hasEnvKey: Boolean(process.env.DEEPSEEK_API_KEY)
    });
  }
  if (req.method === 'POST' && urlPath === '/api/analyze') {
    return handleAnalyze(req, res);
  }
  if (req.method === 'POST' && urlPath === '/api/evaluate-thought') {
    return handleEvaluateThought(req, res);
  }
  if (req.method === 'POST' && urlPath === '/api/variant') {
    return handleVariant(req, res);
  }

  // 静态文件服务
  let filePath = path.join(PUBLIC_DIR, urlPath === '/' ? 'index.html' : urlPath);
  if (!filePath.startsWith(PUBLIC_DIR)) {
    res.writeHead(403);
    return res.end('Forbidden');
  }
  if (!fs.existsSync(filePath) || fs.statSync(filePath).isDirectory()) {
    filePath = path.join(PUBLIC_DIR, 'index.html');
  }
  const ext = path.extname(filePath).toLowerCase();
  res.writeHead(200, { 'Content-Type': MIME_TYPES[ext] || 'application/octet-stream' });
  fs.createReadStream(filePath).pipe(res);
});

server.listen(PORT, () => {
  console.log(`循迹·化析 服务器已启动: http://localhost:${PORT}`);
});
